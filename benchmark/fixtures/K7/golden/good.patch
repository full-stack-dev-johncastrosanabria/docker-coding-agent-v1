+++ b/tests/test_email.py
@@ -0,0 +1,19 @@
+import unittest
+
+from contacts.display import format_contact
+from contacts.model import Contact
+from contacts.serialize import from_dict, to_dict
+
+
+class EmailTest(unittest.TestCase):
+    def test_round_trip_with_email(self):
+        contact = Contact(name="Ada", phone="1", email="ada@example.com")
+        self.assertEqual(from_dict(to_dict(contact)), contact)
+
+    def test_display_with_email(self):
+        self.assertEqual(format_contact(Contact(name="Ada", phone="1", email="a@b.c")),
+                         "Ada (1) <a@b.c>")
+
+
+if __name__ == "__main__":
+    unittest.main()
