diff --git a/tests/test_reservations.py b/tests/test_reservations.py
new file mode 100644
index 0000000..b3f86a7
--- /dev/null
+++ b/tests/test_reservations.py
@@ -0,0 +1,24 @@
+import unittest
+
+from inventory.stock import Stock
+
+
+class ReservationTest(unittest.TestCase):
+    def test_reserve_then_fulfill(self):
+        stock = Stock()
+        stock.receive("A-1", 10)
+        stock.reserve("o1", "A-1", 3)
+        self.assertEqual(stock.available("A-1"), 7)
+        stock.fulfill("o1")
+        self.assertEqual(stock.on_hand("A-1"), 7)
+
+    def test_ship_respects_reservations(self):
+        stock = Stock()
+        stock.receive("A-1", 2)
+        stock.reserve("o1", "A-1", 2)
+        with self.assertRaises(ValueError):
+            stock.ship("A-1", 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
