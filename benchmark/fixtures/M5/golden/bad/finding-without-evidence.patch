@@ -0,0 +1,11 @@
+import unittest
+
+from billing.refunds import refund_lines
+
+
+class HalfUpTest(unittest.TestCase):
+    def test_a_share_is_rounded_half_up(self):
+        self.assertEqual(refund_lines(100, [("a", 2), ("b", 1)]), [("a", 67), ("b", 33)])
+
+    def test_a_later_line_gets_only_what_is_left(self):
+        self.assertEqual(refund_lines(101, [("a", 1), ("b", 1)]), [("a", 51), ("b", 50)])
