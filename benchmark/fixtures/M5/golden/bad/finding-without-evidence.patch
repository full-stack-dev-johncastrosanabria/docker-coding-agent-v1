diff --git a/billing/shares.py b/billing/shares.py
index 4398700..9428228 100644
--- a/billing/shares.py
+++ b/billing/shares.py
@@ -2,8 +2,16 @@
 
 
 def share(paid_cents, line_cents, order_cents):
-    """This line's part of `paid_cents`, in whole cents.
+    """This line's part of `paid_cents`, rounded half up to a whole cent (FIN-88)."""
+    return (2 * paid_cents * line_cents + order_cents) // (2 * order_cents)
 
-    Truncated: a customer can be left a cent or two short across an order (FIN-88).
-    """
-    return paid_cents * line_cents // order_cents
+
+def split(paid_cents, line_cents):
+    """The refund for each line, in order: its rounded share, capped at what is left of the
+    amount paid, so the refunds never add up to more than was paid (docs/REFUNDS.md, 1)."""
+    order_cents, left, amounts = sum(line_cents), paid_cents, []
+    for cents in line_cents:
+        amount = min(share(paid_cents, cents, order_cents), left)
+        amounts.append(amount)
+        left -= amount
+    return amounts
diff --git a/tests/test_rounding.py b/tests/test_rounding.py
