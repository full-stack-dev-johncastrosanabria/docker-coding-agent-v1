diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..ff7b22c
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,28 @@
+import unittest
+
+from pricing.cli import render
+from pricing.invoice import invoice_total
+from pricing.lines import line_total
+
+
+class TestDiscount(unittest.TestCase):
+    def test_the_discount_amount_is_rounded_down(self):
+        self.assertEqual(line_total(1, 99, 10), 90)
+
+    def test_an_absent_discount_keeps_the_old_total(self):
+        self.assertEqual(line_total(3, 250), 750)
+
+    def test_an_out_of_range_discount_is_rejected(self):
+        for percent in (-1, 101):
+            with self.subTest(percent=percent):
+                with self.assertRaises(ValueError):
+                    line_total(1, 100, percent)
+
+    def test_every_component_uses_the_same_discounted_amount(self):
+        lines = [(2, 500, 50), (1, 125)]
+        self.assertEqual(invoice_total(lines), 625)
+        self.assertEqual(int(render(lines).rsplit("= ", 1)[1]), 625)
+
+
+if __name__ == "__main__":
+    unittest.main()
