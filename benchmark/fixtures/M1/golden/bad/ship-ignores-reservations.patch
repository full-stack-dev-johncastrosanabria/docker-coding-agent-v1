 class Stock:
     def __init__(self):
         self._on_hand = {}
+        self._reservations = {}  # order_id -> (sku, qty)
 
     def receive(self, sku, qty):
         _positive(qty)
@@ -20,8 +21,27 @@ class Stock:
     def skus(self):
         return sorted(self._on_hand)
 
+    def available(self, sku):
+        reserved = sum(qty for held, qty in self._reservations.values() if held == sku)
+        return self.on_hand(sku) - reserved
+
     def ship(self, sku, qty):
         _positive(qty)
         if qty > self.on_hand(sku):
             raise ValueError(f"only {self.on_hand(sku)} of {sku} on hand")
         self._on_hand[sku] -= qty
+
+    def reserve(self, order_id, sku, qty):
+        _positive(qty)
+        if order_id in self._reservations:
+            raise ValueError(f"order {order_id!r} already has a reservation")
+        if qty > self.available(sku):
+            raise ValueError(f"only {self.available(sku)} of {sku} available")
+        self._reservations[order_id] = (sku, qty)
+
+    def release(self, order_id):
+        del self._reservations[order_id]
+
+    def fulfill(self, order_id):
+        sku, qty = self._reservations.pop(order_id)
+        self._on_hand[sku] -= qty
