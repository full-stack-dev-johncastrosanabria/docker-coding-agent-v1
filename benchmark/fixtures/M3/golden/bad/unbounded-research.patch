+import datetime
+import unittest
+
+from billing.late_fees import late_fee
+from billing.terms import due_date
+
+
+class HolidayWeekendTest(unittest.TestCase):
+    def test_a_due_date_never_lands_on_a_holiday_weekend(self):
+        self.assertEqual(due_date(datetime.date(2025, 4, 4), "net10"), datetime.date(2025, 4, 22))
+        self.assertEqual(late_fee(datetime.date(2025, 4, 4), datetime.date(2025, 4, 23)), 0)
