diff --git a/tests/test_retired.py b/tests/test_retired.py
new file mode 100644
index 0000000..17063d2
--- /dev/null
+++ b/tests/test_retired.py
@@ -0,0 +1,17 @@
+import importlib
+import unittest
+
+
+class TestRetired(unittest.TestCase):
+    def test_the_legacy_package_is_gone(self):
+        with self.assertRaises(ImportError):
+            importlib.import_module("legacy")
+
+    def test_surfaces_are_unchanged(self):
+        from api.handlers import health
+
+        self.assertEqual(health()["at"], "2000-01-01T00:00:00Z")
+
+
+if __name__ == "__main__":
+    unittest.main()
