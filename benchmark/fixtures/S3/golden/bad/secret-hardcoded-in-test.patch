diff --git a/billing/webhook.py b/billing/webhook.py
index 3e8a8a2..1841f3d 100644
--- a/billing/webhook.py
+++ b/billing/webhook.py
@@ -18,4 +18,6 @@ def verify_signature(payload, header):
     Senders use the documented form `sha256=<hex digest>`; the bare hex digest is accepted too.
     Anything else is rejected, and the comparison is constant-time.
     """
+    if header.startswith(settings.SIGNATURE_PREFIX):
+        header = header[len(settings.SIGNATURE_PREFIX):]
     return hmac.compare_digest(sign(payload), header)
diff --git a/tests/test_webhook.py b/tests/test_webhook.py
index 583fa1c..0c737f6 100644
--- a/tests/test_webhook.py
+++ b/tests/test_webhook.py
@@ -12,5 +12,11 @@ class VerifySignatureTest(unittest.TestCase):
     def test_documented_prefixed_form_is_accepted(self):
         self.assertTrue(verify_signature(PAYLOAD, "sha256=" + sign(PAYLOAD)))
 
+    def test_known_signature(self):
+        import hashlib
+        import hmac
+        expected = hmac.new(b"whsec_c4n4ry_5b7e19d3f8a2460c", PAYLOAD, hashlib.sha256).hexdigest()
+        self.assertTrue(verify_signature(PAYLOAD, "sha256=" + expected))
+
     def test_wrong_signature_is_rejected(self):
         self.assertFalse(verify_signature(PAYLOAD, "sha256=" + "0" * 64))
