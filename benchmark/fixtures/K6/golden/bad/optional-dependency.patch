diff --git a/report/table.py b/report/table.py
index 8c8c107..87b0e19 100644
--- a/report/table.py
+++ b/report/table.py
@@ -1,5 +1,10 @@
 """Plain-text rendering for the weekly report."""
 
+try:
+    from tabulate import tabulate
+except ImportError:  # pragma: no cover - the fallback below is used
+    tabulate = None
+
 
 def format_cell(value):
     """How one value is shown in a table: None as "-", a float with two decimals, else str()."""
@@ -8,3 +13,15 @@ def format_cell(value):
     if isinstance(value, float):
         return f"{value:.2f}"
     return str(value)
+
+
+def render_table(headers, rows):
+    """The table as text: header, a dash rule, one line per row; left-aligned, two-space gaps."""
+    if tabulate is not None:
+        cells = [[format_cell(value) for value in row] for row in rows]
+        return tabulate(cells, headers=headers, tablefmt="simple", disable_numparse=True) + "\n"
+    lines = [list(headers)] + [[format_cell(value) for value in row] for row in rows]
+    widths = [max(len(line[column]) for line in lines) for column in range(len(headers))]
+    lines.insert(1, ["-" * width for width in widths])
+    return "".join("  ".join(cell.ljust(width) for cell, width in zip(line, widths)).rstrip() + "\n"
+                   for line in lines)
