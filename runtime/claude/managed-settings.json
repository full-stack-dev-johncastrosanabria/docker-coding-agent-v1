{
  "_comment": "tasks.md T053. Managed settings are installed at /etc/claude-code/managed-settings.json by the kit and are root-owned; the workload user cannot write them (G1c). permissions.deny is GENERATED from runtime/policy/actions.yaml by src/dca/policy_rules.py, so it cannot drift from the policy the gate evaluates - the parity test recomputes it. There is deliberately no allow and no ask list: a custom allow rule would execute a tool call without dca-gate ever running, which removes the control this design rests on. allowManagedPermissionRulesOnly and allowManagedHooksOnly make a repository's own .claude/settings.json unable to widen either (G1c). env pins every variable a repository could otherwise use to redirect the control plane or inject code into the hook runner's shell or interpreter.",
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "env": {
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_AUTH_TOKEN": "",
    "ANTHROPIC_BASE_URL": "",
    "ANTHROPIC_MODEL": "",
    "BASH_ENV": "",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_USE_BEDROCK": "",
    "CLAUDE_CODE_USE_VERTEX": "",
    "ENV": "",
    "LD_LIBRARY_PATH": "",
    "LD_PRELOAD": "",
    "PYTHONHOME": "",
    "PYTHONPATH": "",
    "PYTHONSTARTUP": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/opt/dca/bin/dca-gate",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/opt/dca/bin/dca-fingerprint",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/opt/dca/bin/dca-fingerprint",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "mcpServers": {},
