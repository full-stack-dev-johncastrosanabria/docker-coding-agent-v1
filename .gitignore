# Local tgrep search index
.tgrep/
# Rembric local files
.rembric
# macOS system files
.DS_Store
# Spec Kit integration cache (local)
.specify/integrations/.cache/
# Local benchmark and gate work directories
benchmark/work/
gates/**/work/
# Generated `dca bench` results, one directory per bench id (committed summaries: benchmark/baselines/)
benchmark/results/bench-*/
# Python bytecode
__pycache__/
*.py[cod]
# Local installs (`pip install -e .`)
.venv/
*.egg-info/
build/
# Throwaway repositories created by unit tests
tests/**/work/
tests/integration/work/
